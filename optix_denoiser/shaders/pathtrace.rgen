float adaptiveBorderThickness(float depth, vec3 normal, vec2 pixelPos) {
    if (depth > maxDepthThreshold) // adjust threshold as needed
        return 0.0;
    float baseThickness = 200.0; // Your base value
    // Thicker border for complex geometry (based on normal variation)
    float normalComplexity = 1.0 - abs(dot(normal, vec3(0.0, 0.0, 1.0)));
    // Thinner border for distant objects
    float depthFactor = clamp(depth * 2.0, 0.0, 1.0);
