// Pure 3D reprojection: unproject → project to other view
vec2 reprojectVia3D(vec2 screenPos, float depthNorm, mat4 fromViewInv, mat4 fromProjInv,
                     mat4 toView, mat4 toProj)
{
    vec3 worldPos = reprojectWorldPosition(screenPos, depthNorm, fromViewInv, fromProjInv);
    
    if (length(worldPos) > 10000.0) {
        return screenPos;
    }
    
    vec4 otherClip = toProj * (toView * vec4(worldPos, 1.0));
    
    if (otherClip.w <= 0.0) {
        return screenPos;
    }
    
    vec3 otherNdc = otherClip.xyz / otherClip.w;
    vec2 otherScreen = (otherNdc.xy * 0.5 + 0.5) * vec2(gl_LaunchSizeEXT.xy);
    
    return otherScreen;
}

// Return true when the MxM neighborhood around 'center' has max-min depth <= threshold
bool depthNeighborhoodStable(ivec2 center, int M, float maxDeltaMeters)
{
    int halfM = M / 2;
    float minD = 1e30;
    float maxD = -1e30;
    int valid = 0;

    ivec2 imgSize = ivec2(gl_LaunchSizeEXT.xy);

    for (int oy = -halfM; oy <= halfM; ++oy) {
        for (int ox = -halfM; ox <= halfM; ++ox) {
            ivec2 s = center + ivec2(ox, oy);
            if (s.x < 0 || s.x >= imgSize.x || s.y < 0 || s.y >= imgSize.y)
                continue;
            float dnorm = imageLoad(gDepth, s).x;
            if (dnorm <= 0.0) // no depth stored / invalid
                continue;
            float d = getWorldDepth(dnorm); // convert to meters
            minD = min(minD, d);
            maxD = max(maxD, d);
            valid++;
            if ((maxD - minD) > maxDeltaMeters) return false;
        }
    }

    if (valid < reprojRequireValidSamples) // not enough samples -> be conservative
        return false;

    return (maxD - minD) <= maxDeltaMeters;
}


// Add this confidence calculation function
// Check depth continuity in 3x3 neighborhood
float calculateReprojectionConfidence(ivec2 coord, float depth, float parallax) {
    float depthVariance = 0.0;
    int validSamples = 0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 sampleCoord = coord + ivec2(x, y);
            if (sampleCoord.x >= 0 && sampleCoord.x < int(gl_LaunchSizeEXT.x) &&
                sampleCoord.y >= 0 && sampleCoord.y < int(gl_LaunchSizeEXT.y)) {
                
                float sampleDepth = imageLoad(gDepth, sampleCoord).x;
                depthVariance += abs(depth - sampleDepth);
                validSamples++;
            }
        }
    }
    if (validSamples > 0) {
        depthVariance /= float(validSamples);
    }
    float depthConfidence = exp(-depthVariance * 10.0); // Lower confidence near depth edges
    
    // Lower confidence for large parallax (potential occlusion)
    float parallaxConfidence = 1.0 - smoothstep(5.0, 30.0, abs(parallax));
    return depthConfidence * parallaxConfidence; // Combine confidences
}


// Advanced DIBR Coordinate Synthesis
// Finds the exact source coordinate in the dominant eye that corresponds to the current non-dominant pixel
vec2 synthesizeCoordinateAdvanced(vec2 nonDomLocalCoord, bool isLeftNonDom) {
    float searchDir = isLeftNonDom ? -1.0 : 1.0;
    
    int steps = 16; // High quality search
    float maxSearchMeters = 50.0; // Search depth up to 50 meters
    
    float closestDepthHit = 1e30; 
    vec2 bestSourceCoord = nonDomLocalCoord;
    bool foundMatch = false;

    // Search along the epipolar line
    for (int i = 0; i < steps; i++) {
        // Linearly sample depth values in inverse space for better precision close up
        float t = float(i) / float(steps - 1);
        float searchDistMeters = 0.5 + t * maxSearchMeters; // From 0.5m to 50m
        
        // At this depth, what would the parallax be?
        float expectedParallax = (eyeSeparation * gFocalLengthPixels) / searchDistMeters;
        
        // Where would this pixel be in the dominant eye?
        vec2 sampleCoord = nonDomLocalCoord + vec2(searchDir * expectedParallax, 0.0);
        
        // Clamp to avoid reading out of bounds
        if (sampleCoord.x < 0.0 || sampleCoord.x >= float(halfWidth)) continue;

        // Convert to global dominant coordinate to read its stored depth
        ivec2 globalSampleCoord = ivec2(sampleCoord);
        if (isLeftNonDom) globalSampleCoord.x += halfWidth;
        else globalSampleCoord.x -= halfWidth;
        
        // Read actual depth from the dominant eye
        float dNorm = imageLoad(gDepth, clampToViewBounds(globalSampleCoord, !isLeftNonDom, halfWidth)).x;
        
        if (dNorm > 0.0) {
            float actualDistMeters = getWorldDepth(dNorm);
            
            // Does the actual depth at this location match the depth we are searching for?
            // Tolerance increases with distance (perspective effect)
            float tolerance = 0.1 + (actualDistMeters * 0.05); 
            
            if (abs(actualDistMeters - searchDistMeters) < tolerance) {
                // We found a matching surface!
                // Prioritize the closest surface (handles occlusions correctly)
                if (actualDistMeters < closestDepthHit) {
                    closestDepthHit = actualDistMeters;
                    
                    // Refine the exact parallax shift using the actual depth found
                    float refinedParallax = (eyeSeparation * gFocalLengthPixels) / actualDistMeters;
                    bestSourceCoord = nonDomLocalCoord + vec2(searchDir * refinedParallax, 0.0);
                    foundMatch = true;
                    break;
                }
            }
        }
    }
    
    // If no match found, rely on spatial fallback based on neighboring pixels' parallax
    // (This automatically fills in disocclusions/holes with background data)
    if (!foundMatch) {
         // Convert non-dominant coordinate back to dominant global
         vec2 fallbackCoord = nonDomLocalCoord + vec2(searchDir * 0.0, 0.0); // 0 parallax fallback
         if (isLeftNonDom) fallbackCoord.x += float(halfWidth);
         else fallbackCoord.x -= float(halfWidth);
         return fallbackCoord; 
    }
    
    // Convert resolved optimal coordinate to global dominant coordinate
    vec2 finalSourceGlobal = bestSourceCoord;
    if (isLeftNonDom) finalSourceGlobal.x += float(halfWidth);
    else finalSourceGlobal.x -= float(halfWidth);
    
    return finalSourceGlobal;
}

// Calculates allowable error in meters based on Mochizuki et al. (2012)
// "The magnitude of stereopsis in peripheral visual fields"
float calculatePerceptualTolerance(float worldDepthMeters, float pixelDistFromCenter, float focalLengthPxls, int quadrant) {
    // 1. Calculate eccentricity (degrees from the fovea/center)
    //float eccentricityRadians = atan(pixelDistFromCenter / focalLengthPxls);
    //float eccentricityDegrees = degrees(eccentricityRadians);
    float eccentricityRatio = pixelDistFromCenter / focalLengthPxls; 
    
    // 2. Map eccentricity to human stereoacuity in arcseconds
    // Based on the paper's means: 10° = 474, 20° = 725, 30° = 1223
    float arcsecs = 300.0; // Baseline high-acuity fovea bound
    // Precomputed tangent ratios for the paper's degree breakpoints:
    // tan(10°) ≈ 0.176
    // tan(20°) ≈ 0.364
    // tan(30°) ≈ 0.577
    /* Since we only do depth calculating outside the 30 degrees from center*/
    if (eccentricityRatio <= 0.577) { // equivalente a comparar arctang a graus, economiza conta
        // --- QUADRANT RULE ---
        // Paper states: Stereopsis in the lower visual field (Quadrant 3) is "clearer" at 30°.
        // Clearer = Lower threshold (more sensitive to errors, allows less discrepancy).
        float t = (eccentricityRatio - 0.364) / (0.577 - 0.364);
        float maxArcSecs = (quadrant == 3) ? 950.0 : 1223.0; // Stricter in the lower visual field
        arcsecs = mix(725.0, maxArcSecs, t);
    } 
    else {
        // Beyond 30°, stereoacuity heavily degrades up to the 3600 limit stated in the conclusion
        float t = clamp((eccentricityRatio - 0.577) / (1.0 - 0.577), 0.0, 1.0);
        float baseArcSecs = (quadrant == 3) ? 950.0 : 1223.0;
        arcsecs = mix(baseArcSecs, 3600.0, t);
    }
    
    // 3. Convert arcseconds to linear tolerance in meters (Small angle approximation)
    // 1 arcsecond = 1 / 3600 of a degree
    // 1 degree = PI / 180 radians
    // 1 arcsecond = 0.000004848136811 radians
    // Because the angle is so small, tan(radians) == radians.
    float allowedVisualAngleRadians = arcsecs * 0.000004848137;
    
    // Your calculation: arc length = angle * distance
    float toleranceMeters = worldDepthMeters * allowedVisualAngleRadians;
    
    return toleranceMeters;
}

// Shared reprojection algorithm used by both blending and reprojection modes
bool performReprojection(ivec2 otherViewCoord, float depth, float dist, float radius, 
                         float borderThickness, bool isLeftView, vec2 pixelPos, 
                         float time, vec3 normal) {
    bool reprojectionSuccess = false;
    ivec2 dominantCoord = otherViewCoord;
    bool skipWarping = false;
    vec2 dstFullF = vec2(otherViewCoord) + vec2(0.5);
    
    if (depth < maxDepthThreshold) {
        // Get warp strength
        float warpStrengthVal = selectWarpStrength(warpMode, dist, radius, borderThickness,
                                                    depth, pixelPos, normal, time);
        
        if (warpStrengthVal > 0.001) {
            vec2 currentLocalCoord = vec2(gl_LaunchIDEXT.x % halfWidth, gl_LaunchIDEXT.y);
                
            // Execute Advanced DIBR Synthesis
            dstFullF = synthesizeCoordinateAdvanced(currentLocalCoord, isLeftView);
            dominantCoord = ivec2(dstFullF);
                
            if (dominantEye == rightEye) {
                dominantCoord.x = max(halfWidth, min(dominantCoord.x, int(gl_LaunchSizeEXT.x) - 1));
            } else {
                dominantCoord.x = max(0, min(dominantCoord.x, halfWidth - 1));
            }
                
            // --- INTEGRATE CLINICAL DATA ---
            float actualDepthMeters = getWorldDepth(depth);
            int quadrant = getEyeQuadrant();
                
            float dynamicToleranceMeters = calculatePerceptualTolerance(
                actualDepthMeters, 
                dist, 
                gFocalLengthPixels,
                quadrant
            );
            
            // Check if the neighborhood is stable based on perceptual constraints
            skipWarping = !depthNeighborhoodStable(dominantCoord, reprojCheckSize, dynamicToleranceMeters);
            
            // --- FORCE WARPING IN THE PERIPHERY ---
            // If the depth neighborhood is unstable (like a heavy occlusion border on the floor),
            // but we are far in the periphery (dist > radius), the glitch from a strict skip
            // looks much worse than a stretched reprojected pixel.
            // So, in the outer boundary, we IGNORE the skip and force the warp anyway!
            if (skipWarping && dist > radius * 0.8) {
                skipWarping = false; // Override the strict cutoff
            }
        }
        
        // Try to sample from warped coordinate
        if (!skipWarping && dominantCoord.x >= 0 && dominantCoord.x < int(gl_LaunchSizeEXT.x) &&
            dominantCoord.y >= 0 && dominantCoord.y < int(gl_LaunchSizeEXT.y)) {
            
            vec4 colorAccum = imageLoad(image, dominantCoord);
            imageStore(image, ivec2(gl_LaunchIDEXT.xy), colorAccum);
            reprojectionSuccess = true;
            /*
            if (doDebug) {
                imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 1.0, 0.0, 1.0)); // Green for warped reproj
            }
            */
        }
        
        // Fallback to world-space reprojection if warping fails
        if (!reprojectionSuccess) {
            vec3 worldPos = reprojectWorldPosition(vec2(otherViewCoord), depth, dominantViewInv, dominantProjInv);
            vec4 currentClip = nonDomProj * (nonDomView * vec4(worldPos, 1.0));

            if (currentClip.w > 0.0) {
                vec3 ndc = currentClip.xyz / currentClip.w;
                vec2 currentScreen = (ndc.xy * 0.5 + 0.5) * vec2(gl_LaunchSizeEXT.xy);
                ivec2 reprojCoord = ivec2(currentScreen);
                
                // Ensure coordinates are in the correct viewport
                if (isLeftView) {
                    reprojCoord.x = max(0, min(reprojCoord.x, halfWidth - 1));
                } else {
                    reprojCoord.x = max(halfWidth, min(reprojCoord.x, int(gl_LaunchSizeEXT.x) - 1));
                }
                
                if (reprojCoord.x >= 0 && reprojCoord.x < int(gl_LaunchSizeEXT.x) &&
                    reprojCoord.y >= 0 && reprojCoord.y < int(gl_LaunchSizeEXT.y)) 
                {
                    vec4 reprojColor = imageLoad(image, reprojCoord);
                    imageStore(image, ivec2(gl_LaunchIDEXT.xy), reprojColor);
                    reprojectionSuccess = true;
                    /*
                    if (doDebug) {
                        imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(0.5, 1.0, 0.0, 1.0)); // Light green for world reproj
                    }
                    */
                }
            }
        }
    }
    
    // Final fallback: simple copy without warping
    if (!reprojectionSuccess) {
        vec4 otherColor = imageLoad(image, otherViewCoord);
        imageStore(image, ivec2(gl_LaunchIDEXT.xy), otherColor);
        reprojectionSuccess = true;
        
        if (doDebug) {
            imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 1.0, 1.0, 1.0)); // Cyan for simple copy
        }
    }
    
    return reprojectionSuccess;
}


// Updated reprojectPixel to use shared reprojection
bool reprojectPixel(
  float pixelRand, ivec2 otherViewCoord, float depth, 
  float probabilityFactor, float disparityPixels, float dist, float radius, 
  bool isLeftView, float borderThickness
) {
    vec2 pixelPos = vec2(gl_LaunchIDEXT.xy);
    float time = float(pc.frame) * 0.01;
    vec3 normal = vec3(0.0, 0.0, 1.0);
    
    // Load normal if needed
    if (warpMode == WARP_MODE_ADAPTIVE || warpMode == WARP_MODE_MULTIFREQ) {
        vec4 storedNormal = imageLoad(gNormal, otherViewCoord);
        normal = storedNormal.rgb * 2.0 - 1.0;
    }
    debugColor = 1; // Reprojection
    return performReprojection(otherViewCoord, depth, dist, radius, borderThickness, 
                             isLeftView, pixelPos, time, normal);
}


void blendRaytracedAndReprojected(ivec2 otherViewCoord, 
    float depth, float dist, float radius, bool isLeftView, 
    float borderThickness, ivec2 adjustedPixelPos, uint seed) 
    {
    // Calculate normalized distance from center (0 = center, 1 = edge)
    vec2 eyeCenter = vec2(float(halfWidth) * 0.5, float(gl_LaunchSizeEXT.y) * 0.5);
    float eyeLocalX = isLeftView
        ? float(gl_LaunchIDEXT.x)
        : float(int(gl_LaunchIDEXT.x) - halfWidth);
    vec2 eyePos = vec2(eyeLocalX, float(gl_LaunchIDEXT.y));
    float pixelDist = length(eyePos - eyeCenter);
    
    // Normalize distance to [0, 1] range
    float halfDiagonal = length(eyeCenter);
    float normalizedDist = clamp(pixelDist / halfDiagonal, 0.0, 1.0);
    
    // Discrete steps based on distance bands
    float modRange;
    if (normalizedDist < 0.1) {
        modRange = 128.0;  // 1% reproject, 99% raytracing at center
    } else if (normalizedDist < 0.2) {
        modRange = 64.0;  // 2% reproject, 98% raytracing
    } else if (normalizedDist < 0.3) {
        modRange = 32.0;  // 2% reproject, 98% raytracing
    } else if (normalizedDist < 0.4) {
        modRange = 16.0;  // 2% reproject, 98% raytracing
    } else if (normalizedDist < 0.5) {
        modRange = 8.0;  // 3% reproject, 97% raytracing
    } else if (normalizedDist < 0.7) {
        modRange = 4.0;   // 20% reproject, 80% raytracing
    } else if (normalizedDist < 0.9) {
        modRange = 2.0;   // 50% reproject, 50% raytracing
    } else {
        modRange = 2.0;   // 50% reproject, 50% raytracing at edges
    }
    
    // Apply spatial dither pattern
    uint ditherSum = uint(gl_LaunchIDEXT.x) + uint(gl_LaunchIDEXT.y);
    uint bitwiseMask = uint(modRange) - 1u;
    uint ditherPattern = ditherSum & bitwiseMask;
    //uint ditherPattern = ditherSum % uint(max(1u, uint(modRange)));
    
    if (ditherPattern == 0u) {
        // Use reprojection via shared algorithm
        vec2 pixelPos = vec2(gl_LaunchIDEXT.xy);
        float time = float(pc.frame) * 0.01;
        vec3 normal = vec3(0.0, 0.0, 1.0);
        
        // Load normal if needed
        if (warpMode == WARP_MODE_ADAPTIVE || warpMode == WARP_MODE_MULTIFREQ) {
            vec4 storedNormal = imageLoad(gNormal, otherViewCoord);
            normal = storedNormal.rgb * 2.0 - 1.0;
        }
        debugColor = 3;
        performReprojection(otherViewCoord, depth, dist, radius, borderThickness, 
                          isLeftView, pixelPos, time, normal);
    }
    // If ditherPattern != 0, return and let default raytracing in main() handle it
}

bool isInDisparityZone(int pixelX, float depth, bool isLeftView) {
    const float OCCLUSION_ANGLE_DEG = 8.0;
    float occlusionFraction = OCCLUSION_ANGLE_DEG / fovDegrees;
    float occludedPixels = max(occlusionFraction * halfWidthPixels, 10.0);
    float safetyPixels = (1.0 / fovDegrees) * halfWidthPixels;
    float totalOccludedPixels = occludedPixels + safetyPixels;
    
    if (isLeftView) {
        return pixelX < int(totalOccludedPixels);
    } else {
        int viewRelativeX = pixelX - halfWidth;
        int rightmostStart = halfWidth - int(totalOccludedPixels);
        return viewRelativeX >= rightmostStart;
    }
}


//-----------------------------------------------------------------------
// Precompute optical constants once per frame (called in main)
//-----------------------------------------------------------------------
void precomputeOpticalConstants()
{
  gTanHalfFov                 = frameInfo.tanHalfFov;
  gFocalLengthPixels          = frameInfo.focalLengthPixels;
  gMaxComfortableParallaxPixels = frameInfo.maxComfortableParallaxPixels;
  nearDistLinear = frameInfo.clipNear;
  farDistLinear  = frameInfo.clipFar;
  eyeSeparation = frameInfo.eyeSeparation;
  nearDistNorm = 0.1;
  farDistNorm = 1.0;
  halfWidthPixels = frameInfo.halfWidthPixels;
  fovDegrees = frameInfo.fovDegrees;
  radius           = frameInfo.reprojectionRadiusPixels;
}

// implement the rest of dibr logic here


/* TODO: The dominant eye can be set by the user later.*/
void main()
{
  if (pc.showBlackScreen == 1){
    imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 0.0, 0.0, 1.0));
    return;
  }
  /* --- Setup common values --- */
  halfWidth = int(gl_LaunchSizeEXT.x * 0.5);
  precomputeOpticalConstants();

  /* --- Determine view types --- */
  isLeftView = gl_LaunchIDEXT.x < halfWidth;
  
  if (pc.mode == 0 || pc.mode == 2) {
    dominantEye = rightEye;
    isDominantView = !isLeftView;
    isNotDominantView = isLeftView;
  } else if (pc.mode == 1) {
    dominantEye = leftEye;
    isDominantView = isLeftView;
    isNotDominantView = !isLeftView;
  }

  /* --- Setup matrices based on dominant eye --- */
  if (dominantEye == leftEye) {
    if((pc.passId == 0 && !isLeftView)) return;
    if(pc.passId == 1 && isLeftView) return;
    
    dominantViewInv = frameInfo.viewInv;
    dominantProjInv = frameInfo.projInv;
    nonDomViewInv   = frameInfo.view2Inv;
    nonDomProjInv   = frameInfo.proj2Inv;
    dominantView    = frameInfo.view;
    dominantProj    = frameInfo.proj;
    nonDomView      = frameInfo.view2;
    nonDomProj      = frameInfo.proj2;
  }
  else if (dominantEye == rightEye) {
    if((pc.passId == 0 && isLeftView)) return;
    if(pc.passId == 1 && !isLeftView) return;
    
    dominantViewInv = frameInfo.view2Inv;
    dominantProjInv = frameInfo.proj2Inv;
    nonDomViewInv   = frameInfo.viewInv;
    nonDomProjInv   = frameInfo.projInv;
    dominantView    = frameInfo.view2;
    dominantProj    = frameInfo.proj2;
    nonDomView      = frameInfo.view;
    nonDomProj      = frameInfo.proj;
  }

  /* --- Adjust pixel coordinates --- */
  ivec2 adjustedPixelPos = ivec2(gl_LaunchIDEXT.xy);
  ivec2 otherViewCoord = ivec2(gl_LaunchIDEXT.xy);
  otherViewCoord = clampToViewBounds(otherViewCoord, !isLeftView, halfWidth);
  
  if (isLeftView) {
    adjustedPixelPos.x *= 2;
    otherViewCoord.x = int(gl_LaunchIDEXT.x + halfWidth);
  } else {
    adjustedPixelPos.x = (adjustedPixelPos.x - halfWidth) * 2;
    otherViewCoord.x = int(gl_LaunchIDEXT.x - halfWidth);
  }
  if (pc.doDebug == 0) {
    doDebug = false;
  } else {
    doDebug = true;
  }


  // Initialize random seed for ALL pixels
  uint seed = xxhash32(uvec3(adjustedPixelPos, pc.frame));
  
  // Default values
  float depth = 0.0;
  bool inDisparitySkipZone = false;
  float borderThickness = 200.0;
  float parallaxPixels = 0.0;
  vec3 normal = vec3(0.0, 0.0, 1.0);
  // Calculate distance from screen center for ALL pixels
  float eyeLocalX = isLeftView
    ? float(gl_LaunchIDEXT.x)
    : float(int(gl_LaunchIDEXT.x) - halfWidth);

  vec2 eyeCenter = vec2(float(halfWidth) * 0.5, float(gl_LaunchSizeEXT.y) * 0.5);
  vec2 eyePos    = vec2(eyeLocalX, float(gl_LaunchIDEXT.y));

  dist = length(eyePos - eyeCenter);
  
  
  // Load dominant eye data if this is non-dominant view in second pass
  if (isNotDominantView && pc.passId == 1) {
    if(pc.mode == -1) {
        // In this mode, we only want to test reprojection without warping, so we skip loading depth/normal and just use a fixed parallax
        doReprojection = false;
    } else {
        vec4 dominantDepth = imageLoad(gDepth, otherViewCoord);
        depth = dominantDepth.x;
    
        inDisparitySkipZone = isInDisparityZone(int(gl_LaunchIDEXT.x), depth, isLeftView);
        parallaxPixels = calculateParallaxPixelsValidated(depth);
    
        // Calculate adaptive border thickness
        vec4 normalData = imageLoad(gNormal, otherViewCoord);
        normal = normalData.rgb * 2.0 - 1.0;
        //borderThickness = adaptiveBorderThickness(depth, normal, vec2(gl_LaunchIDEXT.xy));
        borderThickness = max(
            baseBorderThickness, 
            adaptiveBorderThickness(depth, normal, vec2(gl_LaunchIDEXT.xy))
            );

        // --- ADAPTIVE REPROJECTION DECISION (same as working code) ---
        // Close objects (small depth) will NOT be reprojected
        // Far objects (large depth) WILL be reprojected
        float linearDepth = getWorldDepth(depth); // Convert to meters

        int quadrant = getEyeQuadrant();
        float baseDepthThreshold = 1.0; // 1 meter base
        if (quadrant == 0) baseDepthThreshold = rightDepthThreshold;
        else if (quadrant == 1) baseDepthThreshold = upperDepthThreshold;
        else if (quadrant == 2) baseDepthThreshold = leftDepthThreshold;
        else baseDepthThreshold = bottomDepthThreshold;

        float distanceFromCenter = dist;
        float distanceFactor = smoothstep(0.0, radius, distanceFromCenter);
        float depthThreshold = baseDepthThreshold * mix(1.0, 3.0, distanceFactor);

        // Only reproject if depth is beyond adaptive threshold
        if ((dist > radius && !inDisparitySkipZone && linearDepth > 0.1) && 
            linearDepth > depthThreshold) {
            doReprojection = true;
        }
        else {
            doReprojection = false;
        }
    
        float confidence = calculateReprojectionConfidence(otherViewCoord, depth, parallaxPixels);
        if (confidence < 1 - depth) {
            doReprojection = false; // too noisy to reproject this pixel
        }
    }


  /* --- Debug visualization --- */
  /*
  if (doDebug && pc.passId == 1) {
    if (doReprojection) {
      imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(1.0, 0.0, 0.0, 1.0));
    } else {
      imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 0.0, 1.0, 1.0));
    }
    return;
  }

  */
    if (pc.passId == 0) {
        doDebug = false;
    }
    if (doReprojection) {
        float depthInfluence = 1.0 - smoothstep(nearDistNorm, farDistNorm, depth);
        float distanceInfluence = clamp((dist - radius) / borderThickness, 0.0, 1.0);
        float transitionFactor = distanceInfluence * (1.0 - depthInfluence * 0.5);

        bool insideBaseBorder = (dist > radius) && (dist <= radius + baseBorderThickness);

        
        if ((transitionFactor >= 0.4 || depth > maxDepthThreshold) && pc.mode != 2) {
            reprojectPixel(0.0, otherViewCoord, depth, 0.0, parallaxPixels,
                            dist, radius, isLeftView, borderThickness);
            //return;
            
            if (!doDebug) {
                return; // Skip raytracing if reprojection was used and we're not debugging
            }
            if (depth > maxDepthThreshold){
                debugColor = 2; // for max depth-based reprojection
            }else {
                debugColor = 1; //reprojection
            }
        }
        // First: blend if we're in the transition zone or inside the base border
        else if (((transitionFactor > 0.1 && transitionFactor < 0.4) || insideBaseBorder) && pc.mode != 2) {
            float blendAmount = max(transitionFactor, insideBaseBorder ? 0.1 : 0.0);

            blendRaytracedAndReprojected(otherViewCoord, depth,
                                            dist, radius, isLeftView,
                                            baseBorderThickness, adjustedPixelPos, seed);
            if (!doDebug && debugColor != 0) { // if not raytrace and not debug, return
                return; // Skip raytracing if reprojection was used and we're not debugging
            }
        }
    }
  }
  
  if (doDebug && pc.passId == 1){
    if(debugColor == 1) {
        imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(1.0, 0.0, 0.0, 1.0)); // Red-reprojection
    } else if (debugColor == 2) {
        imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(1.0, 1.0, 1.0, 1.0)); // White-max depth reproj.
    } else if (debugColor == 0) {
        imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 0.0, 1.0, 1.0)); // Blue-raytracing
    } else if (debugColor == 3) {
        imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(1.0, 1.0, 0.0, 1.0)); // Yellowish-blended Reproj.
    }
    return;
  }

  /* --- Path tracing for all other cases --- */
  vec3 contribAccum = vec3(0.0);
  float primaryT = -1.0;
  
  // Use full samples for path tracing
  for(uint s = 0; s < pc.maxSamples; s++) {
    bool captureDepth = (s == 0);
    float t0 = -1.0;
    contribAccum += samplePixel(seed, adjustedPixelPos, captureDepth, t0);
    if(s == 0) primaryT = t0;
  }
  contribAccum /= pc.maxSamples;

  /* --- Store results --- */
  if(pc.frame == 0) {
    //if (doDebug){
    //    imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 0.0, 1.0, 1.0));
    //}else{
        imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(contribAccum, 1.f));
    //}
    // G-buffers - only trace when needed
    if (isDominantView || (isNotDominantView && !doReprojection)) {
      traceAlbedo(adjustedPixelPos);
      imageStore(gAlbedo, ivec2(gl_LaunchIDEXT.xy), gUnpackedAlbedo);
      
      gUnpackedNormal = (gUnpackedNormal * vec3(0.5)) + vec3(0.5);
      imageStore(gNormal, ivec2(gl_LaunchIDEXT.xy), vec4(gUnpackedNormal, 1));
      
      /*if (isDominantView && pc.passId == 0) {
        float d = uintBitsToFloat(payloadGbuf.packDepth);
        //imageStore(gDepth, ivec2(gl_LaunchIDEXT.xy), vec4(d, 0.0, 0.0, 0.0));
        float linearDepth = (2.0 * nearDistLinear * farDistLinear) / 
                    (farDistLinear + nearDistLinear - (2.0 * d - 1.0) * (farDistLinear - nearDistLinear));
        imageStore(gDepth, ivec2(gl_LaunchIDEXT.xy), vec4(linearDepth, 0.0, 0.0, 0.0));
      }*/
      // With:
    if (isDominantView && pc.passId == 0) {
        float d = uintBitsToFloat(payloadGbuf.packDepth); // normalized linear depth [0,1]
        imageStore(gDepth, ivec2(gl_LaunchIDEXT.xy), vec4(d, 0.0, 0.0, 0.0));
    }
    } else if (isNotDominantView && doReprojection) {
      // Copy G-buffers from dominant view
      //imageStore(gAlbedo, ivec2(gl_LaunchIDEXT.xy), imageLoad(gAlbedo, otherViewCoord));
      //imageStore(gNormal, ivec2(gl_LaunchIDEXT.xy), imageLoad(gNormal, otherViewCoord));
      //imageStore(gDepth, ivec2(gl_LaunchIDEXT.xy), imageLoad(gDepth, otherViewCoord));
    }
    
    // Mark disparity
    /*
    if (inDisparitySkipZone) {
        imageStore(gDisparity, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 0.0, 1.0, 1.0));
    } else if (dist <= radius) {
        imageStore(gDisparity, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 1.0, 0.0, 1.0));
    } else {
        imageStore(gDisparity, ivec2(gl_LaunchIDEXT.xy), vec4(1.0, 1.0, 0.0, 1.0));
    }*/

    } else {
        float a = 1.0f / float(pc.frame + 1);
        vec3 old_color = imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).xyz;
        //if (doDebug && pc.passId == 1){
        //      imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 0.0, 1.0, 1.0));
        //  }else{
        imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(mix(old_color, contribAccum, a), 1.f));
        //}
    }
}