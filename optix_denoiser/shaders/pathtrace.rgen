// Warping mode selector function
float selectWarpStrength(int mode, float dist, float radius, float borderThickness,
                        float depth, vec2 pixelPos, vec3 normal, float time) {
    if (mode == WARP_MODE_SIMPLE) {
        return warpStrength(dist, radius, borderThickness);
    }
    else if (mode == WARP_MODE_FLUID) {
        return fluidWarpStrength(dist, radius, borderThickness, pixelPos, time);
    }
    else if (mode == WARP_MODE_ADAPTIVE) {
        return adaptiveWarpStrength(dist, radius, borderThickness, depth, pixelPos, normal, time);
    }
    else if (mode == WARP_MODE_PERLIN) {
        return perlinWarpStrength(dist, radius, borderThickness, pixelPos, time, depth);
    }
    else { // WARP_MODE_MULTIFREQ (default)
        return adaptiveMultiFrequencyWarp(dist, radius, borderThickness, 
                                         depth, pixelPos, normal, time);
    }
}
