    // Remove trigonometric noise for speed
    float baseThickness = 200.0;
    float normalComplexity = 1.0 - abs(dot(normal, vec3(0.0, 0.0, 1.0)));
    float depthFactor = clamp(depth * 2.0, 0.0, 1.0);
    return baseThickness * mix(0.8, 1.2, normalComplexity) * mix(1.0, 0.7, depthFactor);
}
*/


// Warping mode selector function
float selectWarpStrength(int mode, float dist, float radius, float borderThickness,
                        float depth, vec2 pixelPos, vec3 normal, float time) {
    if (mode == WARP_MODE_SIMPLE) {
        return warpStrength(dist, radius, borderThickness);
    }
    else if (mode == WARP_MODE_FLUID) {
        return fluidWarpStrength(dist, radius, borderThickness, pixelPos, time);
    }
    else if (mode == WARP_MODE_ADAPTIVE) {
        return adaptiveWarpStrength(dist, radius, borderThickness, depth, pixelPos, normal, time);
    }
    else if (mode == WARP_MODE_PERLIN) {
        return perlinWarpStrength(dist, radius, borderThickness, pixelPos, time, depth);
    }
    else { // WARP_MODE_MULTIFREQ (default)
        return adaptiveMultiFrequencyWarp(dist, radius, borderThickness, 
                                         depth, pixelPos, normal, time);
    }
}


bool reprojectPixel(
  float pixelRand, ivec2 otherViewCoord, float depth, 
  float probabilityFactor, float disparityPixels, float dist, float radius, 
  bool isLeftView, float borderThickness
) {
    bool reprojectionSuccess = false;
    ivec2 dominantCoord = otherViewCoord;
    bool skipRayTrace = false;
    
    if (depth < maxDepthThreshold) {
      // Get pixel position for fluid warping
      vec2 pixelPos = vec2(gl_LaunchIDEXT.xy);
      float time = float(pc.frame) * 0.01; // Animate over time
      vec3 normal  = vec3(0.0, 0.0, 1.0);

      // Only trace albedo for warp modes that actually need normals
      if (warpMode == WARP_MODE_ADAPTIVE || warpMode == WARP_MODE_MULTIFREQ) {
          // Read normal from already-rendered dominant eye instead of tracing a new ray
          vec4 storedNormal = imageLoad(gNormal, otherViewCoord);
          normal = storedNormal.rgb * 2.0 - 1.0; // Unpack from [0,1] to [-1,1]
      }
      
      float warpStrengthVal = selectWarpStrength(warpMode, dist, radius, borderThickness,
                                                  depth, pixelPos, normal, time);
        
      
      // Apply the warp
      if (warpStrengthVal > 0.001) {
          float parallax = calculateParallaxPixelsValidated(depth);
          float warpDirection = isLeftView ? 1.0 : -1.0;
          float shift = parallax * warpStrengthVal;
          
          dominantCoord.x += int(warpDirection * shift);
          
          // Ensure within bounds
          if (dominantEye == rightEye) {
              dominantCoord.x = max(halfWidth, min(dominantCoord.x, int(gl_LaunchSizeEXT.x) - 1));
          } else {
              dominantCoord.x = max(0, min(dominantCoord.x, halfWidth - 1));
          }
      }
      
      // Try to sample from warped coordinate
      if (dominantCoord.x >= 0 && dominantCoord.x < int(gl_LaunchSizeEXT.x) &&
          dominantCoord.y >= 0 && dominantCoord.y < int(gl_LaunchSizeEXT.y)) {
          
          // Optional: Sample multiple points for smoother transition
          vec4 colorAccum = vec4(0.0);
          vec4 albedoAccum = vec4(0.0);
          vec4 normalAccum = vec4(0.0);
          int samples = 1;
          
          // Single sample for now (can be expanded to multi-sample)
          colorAccum = imageLoad(image, dominantCoord);
          //albedoAccum = imageLoad(gAlbedo, dominantCoord);
          //normalAccum = imageLoad(gNormal, dominantCoord);
          
          imageStore(image, ivec2(gl_LaunchIDEXT.xy), colorAccum);
          //imageStore(gAlbedo, ivec2(gl_LaunchIDEXT.xy), albedoAccum);
          //imageStore(gNormal, ivec2(gl_LaunchIDEXT.xy), normalAccum);
          reprojectionSuccess = true;
      }
      
      // Fallback to world-space reprojection if warping fails
      if (!reprojectionSuccess) {
          vec3 worldPos = reprojectWorldPosition(vec2(otherViewCoord), depth, dominantViewInv, dominantProjInv);
          vec4 currentClip = nonDomProj * (nonDomView * vec4(worldPos, 1.0));

          if (currentClip.w > 0.0) {
              vec3 ndc = currentClip.xyz / currentClip.w;
              vec2 currentScreen = (ndc.xy * 0.5 + 0.5) * vec2(gl_LaunchSizeEXT.xy);
              ivec2 reprojCoord = ivec2(currentScreen);
              
              // Ensure coordinates are in the correct viewport
              if (isLeftView) {
                  reprojCoord.x = max(0, min(reprojCoord.x, halfWidth - 1));
              } else {
                  reprojCoord.x = max(halfWidth, min(reprojCoord.x, int(gl_LaunchSizeEXT.x) - 1));
              }
              
              if (reprojCoord.x >= 0 && reprojCoord.x < int(gl_LaunchSizeEXT.x) &&
                  reprojCoord.y >= 0 && reprojCoord.y < int(gl_LaunchSizeEXT.y)) 
              {
                  vec4 reprojColor = imageLoad(image, reprojCoord);
                  imageStore(image, ivec2(gl_LaunchIDEXT.xy), reprojColor);
                  
                  //vec4 reprojAlbedo = imageLoad(gAlbedo, reprojCoord);
                  //imageStore(gAlbedo, ivec2(gl_LaunchIDEXT.xy), reprojAlbedo);
                  
                  //vec4 reprojNormal = imageLoad(gNormal, reprojCoord);
                  //imageStore(gNormal, ivec2(gl_LaunchIDEXT.xy), reprojNormal);
                  reprojectionSuccess = true;
                  
                  //imageStore(gDisparity, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 0.0, 1.0, 1.0)); // Blue for fallback
              }
          }
      }
  }
  // Final fallback: simple copy without warping
  if (!reprojectionSuccess) {
      vec4 otherColor = imageLoad(image, otherViewCoord);
      imageStore(image, ivec2(gl_LaunchIDEXT.xy), otherColor);
      
      //vec4 otherAlbedo = imageLoad(gAlbedo, otherViewCoord);
      //imageStore(gAlbedo, ivec2(gl_LaunchIDEXT.xy), otherAlbedo);
      
      //vec4 otherNormal = imageLoad(gNormal, otherViewCoord);
      //imageStore(gNormal, ivec2(gl_LaunchIDEXT.xy), otherNormal);
      // imageStore(gDisparity, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 0.0, 1.0, 1.0)); // Blue for reprojection
      reprojectionSuccess = true;

  }
  //imageStore(gDisparity, ivec2(gl_LaunchIDEXT.xy), vec4(1.0, 0.0, 0.0, 1.0));
  
  return skipRayTrace;
}

void blendRaytracedAndReprojected(float blendFactor, ivec2 otherViewCoord, float depth, 
                                 float disparityPixels, float dist, float radius, 
                                 bool isLeftView, float borderThickness, ivec2 adjustedPixelPos, uint seed) {
    
    // Sample reprojected content
    ivec2 reprojCoord = otherViewCoord;
    float parallaxPixels = calculateParallaxPixelsValidated(depth);    //VALIDATED parallax
    //float parallaxPixels = 0.3;    //For testing
    
    float parallaxShift = parallaxPixels * blendFactor;
    
    float warpDirection = isLeftView ? 1.0 : -1.0;
    reprojCoord.x += int(warpDirection * parallaxShift);  // Apply warping on blended reproj coord
    
    // Ensure within bounds
    if (dominantEye == rightEye) {
        reprojCoord.x = max(halfWidth, min(reprojCoord.x, int(gl_LaunchSizeEXT.x) - 1));
    } else {
        reprojCoord.x = max(0, min(reprojCoord.x, halfWidth - 1));
    }
    
    // Get reprojected color
    vec3 reprojColor = vec3(0.0);
    vec3 reprojAlbedo = vec3(0.0);
    vec3 reprojNormal = vec3(0.0);
    
    if (reprojCoord.x >= 0 && reprojCoord.x < int(gl_LaunchSizeEXT.x)) {
        reprojColor = imageLoad(image, reprojCoord).rgb;
        //reprojAlbedo = imageLoad(gAlbedo, reprojCoord).rgb;
        //reprojNormal = imageLoad(gNormal, reprojCoord).rgb;
    }
    
    // Get raytraced color for this pixel
    float primaryT_dummy;
    vec3 raytracedColor = samplePixel(seed, adjustedPixelPos, false, primaryT_dummy);
    
    // Trace albedo/normal for current pixel
    traceAlbedo(adjustedPixelPos);
    //vec3 raytracedAlbedo = gUnpackedAlbedo.rgb;
    //vec3 raytracedNormal = gUnpackedNormal;
    
    // Blend between raytraced and reprojected
    vec3 finalColor = mix(raytracedColor, reprojColor, blendFactor);
    //vec3 finalAlbedo = mix(raytracedAlbedo, reprojAlbedo, blendFactor);
    //vec3 finalNormal = mix(raytracedNormal, reprojNormal, blendFactor);
    
    // Store results
    imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(finalColor, 1.0));
    //imageStore(gAlbedo, ivec2(gl_LaunchIDEXT.xy), vec4(finalAlbedo, 1.0));
    //imageStore(gNormal, ivec2(gl_LaunchIDEXT.xy), vec4(finalNormal, 1.0));
    
    // Visualize blend factor
    //imageStore(gDisparity, ivec2(gl_LaunchIDEXT.xy), vec4(blendFactor, 1.0 - blendFactor, 0.0, 1.0));
}

bool isInDisparityZone(int pixelX, float depth, bool isLeftView) {
    const float OCCLUSION_ANGLE_DEG = 8.0;
    float occlusionFraction = OCCLUSION_ANGLE_DEG / fovDegrees;
    float occludedPixels = max(occlusionFraction * halfWidthPixels, 10.0);
    float safetyPixels = (1.0 / fovDegrees) * halfWidthPixels;
    float totalOccludedPixels = occludedPixels + safetyPixels;
    
    if (isLeftView) {
        return pixelX < int(totalOccludedPixels);
    } else {
        int viewRelativeX = pixelX - halfWidth;
        int rightmostStart = halfWidth - int(totalOccludedPixels);
        return viewRelativeX >= rightmostStart;
    }
}

// Add this confidence calculation function
// Check depth continuity in 3x3 neighborhood
float calculateReprojectionConfidence(ivec2 coord, float depth, float parallax) {
    float depthVariance = 0.0;
    int validSamples = 0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 sampleCoord = coord + ivec2(x, y);
            if (sampleCoord.x >= 0 && sampleCoord.x < int(gl_LaunchSizeEXT.x) &&
                sampleCoord.y >= 0 && sampleCoord.y < int(gl_LaunchSizeEXT.y)) {
                
                float sampleDepth = imageLoad(gDepth, sampleCoord).x;
                depthVariance += abs(depth - sampleDepth);
                validSamples++;
            }
        }
    }
    if (validSamples > 0) {
        depthVariance /= float(validSamples);
    }
    float depthConfidence = exp(-depthVariance * 10.0); // Lower confidence near depth edges
    
    // Lower confidence for large parallax (potential occlusion)
    float parallaxConfidence = 1.0 - smoothstep(5.0, 30.0, abs(parallax));
    return depthConfidence * parallaxConfidence; // Combine confidences
}

// implement the rest of dibr logic here


/* TODO: The dominant eye can be set by the user later.*/
void main()
{
  /* --- Setup common values --- */
  vec2 screenCenter = vec2(gl_LaunchSizeEXT.x * 0.5, gl_LaunchSizeEXT.y * 0.5);
  halfWidth = int(gl_LaunchSizeEXT.x * 0.5);
  halfWidthPixels = float(halfWidth);
  fovDegrees = pc.fovDegrees;
  float pixelRange = min(float(halfWidth), float(gl_LaunchSizeEXT.y)); 
  float pxToFoV    = fovDegrees / pixelRange;     // degrees per pixel
  float midRadius = pc.middleRadius * fovDegrees / 100; // Convert from percentage of FOV to degrees

  float radiusDeg  = midRadius * 0.5 * fovDegrees; // [0..1] -> [0..fovDegrees]
  radius           = radiusDeg / pxToFoV;          // back to pixels for existing comparisons
  

  eyeSeparation = pc.eyeSeparation;
  maxParallaxWarp = gMaxComfortableParallaxPixels;
  nearDistLinear = frameInfo.clipNear;
  farDistLinear  = frameInfo.clipFar;
  nearDistNorm = 0.1;
  farDistNorm = 1.0;
  precomputeOpticalConstants();

  /* --- Determine view types --- */
  isLeftView = gl_LaunchIDEXT.x < halfWidth;
  
  if (pc.mode == 0) {
    dominantEye = rightEye;
    isDominantView = !isLeftView;
    isNotDominantView = isLeftView;
  } else if (pc.mode == 1) {
    dominantEye = leftEye;
    isDominantView = isLeftView;
    isNotDominantView = !isLeftView;
  }

  /* --- Setup matrices based on dominant eye --- */
  if (dominantEye == leftEye) {
    if((pc.passId == 0 && !isLeftView)) return;
    if(pc.passId == 1 && isLeftView) return;
    
    dominantViewInv = frameInfo.viewInv;
    dominantProjInv = frameInfo.projInv;
    nonDomViewInv   = frameInfo.view2Inv;
    nonDomProjInv   = frameInfo.proj2Inv;
    dominantView    = frameInfo.view;
    dominantProj    = frameInfo.proj;
    nonDomView      = frameInfo.view2;
    nonDomProj      = frameInfo.proj2;
  }
  else if (dominantEye == rightEye) {
    if((pc.passId == 0 && isLeftView)) return;
    if(pc.passId == 1 && !isLeftView) return;
    
    dominantViewInv = frameInfo.view2Inv;
    dominantProjInv = frameInfo.proj2Inv;
    nonDomViewInv   = frameInfo.viewInv;
    nonDomProjInv   = frameInfo.projInv;
    dominantView    = frameInfo.view2;
    dominantProj    = frameInfo.proj2;
    nonDomView      = frameInfo.view;
    nonDomProj      = frameInfo.proj;
  }

  /* --- Adjust pixel coordinates --- */
  ivec2 adjustedPixelPos = ivec2(gl_LaunchIDEXT.xy);
  ivec2 otherViewCoord = ivec2(gl_LaunchIDEXT.xy);
  otherViewCoord = clampToViewBounds(otherViewCoord, !isLeftView, halfWidth);
  
  if (isLeftView) {
    adjustedPixelPos.x *= 2;
    otherViewCoord.x = int(gl_LaunchIDEXT.x + halfWidth);
  } else {
    adjustedPixelPos.x = (adjustedPixelPos.x - halfWidth) * 2;
    otherViewCoord.x = int(gl_LaunchIDEXT.x - halfWidth);
  }

  // Initialize random seed for ALL pixels
  uint seed = xxhash32(uvec3(adjustedPixelPos, pc.frame));
  
  // Default values
  float depth = 0.0;
  bool inDisparitySkipZone = false;
  float borderThickness = 200.0;
  float parallaxPixels = 0.0;
  vec3 normal = vec3(0.0, 0.0, 1.0);
  // Calculate distance from screen center for ALL pixels
  float eyeLocalX = isLeftView
    ? float(gl_LaunchIDEXT.x)
    : float(int(gl_LaunchIDEXT.x) - halfWidth);

  vec2 eyeCenter = vec2(float(halfWidth) * 0.5, float(gl_LaunchSizeEXT.y) * 0.5);
  vec2 eyePos    = vec2(eyeLocalX, float(gl_LaunchIDEXT.y));

  dist = length(eyePos - eyeCenter);
  //dist = length(adjustedPixelPos.xy - screenCenter);
  
  
  // Load dominant eye data if this is non-dominant view in second pass
  if (isNotDominantView && pc.passId == 1) {
    vec4 dominantDepth = imageLoad(gDepth, otherViewCoord);
    depth = dominantDepth.x;
    
    inDisparitySkipZone = isInDisparityZone(int(gl_LaunchIDEXT.x), depth, isLeftView);
    parallaxPixels = calculateParallaxPixelsValidated(depth);
    
    // Calculate adaptive border thickness
    vec4 normalData = imageLoad(gNormal, otherViewCoord);
    normal = normalData.rgb * 2.0 - 1.0;
    borderThickness = adaptiveBorderThickness(depth, normal, vec2(gl_LaunchIDEXT.xy));
    
    // --- ADAPTIVE REPROJECTION DECISION (same as working code) ---
    // Close objects (small depth) will NOT be reprojected
    // Far objects (large depth) WILL be reprojected
    //if ((dist > radius && !inDisparitySkipZone && depth > 0.1) || depth > maxDepthThreshold) {
    float linearDepth = getWorldDepth(depth); // Convert to meters
    float depthThreshold = 5.0; // 5 meters threshold

    if ((dist > radius && !inDisparitySkipZone && linearDepth > 0.5) || linearDepth > depthThreshold) {
        doReprojection = true;
    }
    else {
        doReprojection = false;
    }
    
    if (doReprojection) {
        // Depth influence - closer objects stay raytraced longer
        float depthInfluence = 1.0 - smoothstep(nearDistNorm, farDistNorm, depth);
        
        // Distance influence
        float distanceInfluence = clamp((dist - radius) / borderThickness, 0.0, 1.0);
        
        // Combined transition factor
        float transitionFactor = distanceInfluence * (1.0 - depthInfluence * 0.5);
        
        if (transitionFactor >= 0.4 || depth > maxDepthThreshold) {
            // Full reprojection for far periphery
            reprojectPixel(0.0, otherViewCoord, depth, 0.0, parallaxPixels, 
                          dist, radius, isLeftView, borderThickness);
            return;
        } else if (transitionFactor > 0.1) {
            // Smooth transition zone - blend
            blendRaytracedAndReprojected(transitionFactor, otherViewCoord, depth, 
                                       parallaxPixels, dist, radius, isLeftView, 
                                       borderThickness, adjustedPixelPos, seed);
            return;
        }
        // If transitionFactor <= 0.1, fall through to path tracing (close objects)
    }
  }

  /* --- Debug visualization --- */
  bool doDebug = false;
  if (doDebug && pc.passId == 1) {
    if (doReprojection) {
      imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(1.0, 0.0, 0.0, 1.0));
    } else {
      imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 0.0, 1.0, 1.0));
    }
    return;
  }

  /* --- Path tracing for all other cases --- */
  vec3 contribAccum = vec3(0.0);
  float primaryT = -1.0;
  
  // Use full samples for path tracing
  for(uint s = 0; s < pc.maxSamples; s++) {
    bool captureDepth = (s == 0);
    float t0 = -1.0;
    contribAccum += samplePixel(seed, adjustedPixelPos, captureDepth, t0);
    if(s == 0) primaryT = t0;
  }
  contribAccum /= pc.maxSamples;

  /* --- Store results --- */
  if(pc.frame == 0) {
    imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(contribAccum, 1.f));
    
    // G-buffers - only trace when needed
    if (isDominantView || (isNotDominantView && !doReprojection)) {
      traceAlbedo(adjustedPixelPos);
      imageStore(gAlbedo, ivec2(gl_LaunchIDEXT.xy), gUnpackedAlbedo);
      
      gUnpackedNormal = (gUnpackedNormal * vec3(0.5)) + vec3(0.5);
      imageStore(gNormal, ivec2(gl_LaunchIDEXT.xy), vec4(gUnpackedNormal, 1));
      
      if (isDominantView && pc.passId == 0) {
        float d = uintBitsToFloat(payloadGbuf.packDepth);
        //imageStore(gDepth, ivec2(gl_LaunchIDEXT.xy), vec4(d, 0.0, 0.0, 0.0));
        float linearDepth = (2.0 * nearDistLinear * farDistLinear) / 
                    (farDistLinear + nearDistLinear - (2.0 * d - 1.0) * (farDistLinear - nearDistLinear));
        imageStore(gDepth, ivec2(gl_LaunchIDEXT.xy), vec4(linearDepth, 0.0, 0.0, 0.0));
      }
    } else if (isNotDominantView && doReprojection) {
      // Copy G-buffers from dominant view
      //imageStore(gAlbedo, ivec2(gl_LaunchIDEXT.xy), imageLoad(gAlbedo, otherViewCoord));
      //imageStore(gNormal, ivec2(gl_LaunchIDEXT.xy), imageLoad(gNormal, otherViewCoord));
      //imageStore(gDepth, ivec2(gl_LaunchIDEXT.xy), imageLoad(gDepth, otherViewCoord));
    }
    
    // Mark disparity
    /*
    if (inDisparitySkipZone) {
        imageStore(gDisparity, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 0.0, 1.0, 1.0));
    } else if (dist <= radius) {
        imageStore(gDisparity, ivec2(gl_LaunchIDEXT.xy), vec4(0.0, 1.0, 0.0, 1.0));
    } else {
        imageStore(gDisparity, ivec2(gl_LaunchIDEXT.xy), vec4(1.0, 1.0, 0.0, 1.0));
    }*/

    } else {
        float a = 1.0f / float(pc.frame + 1);
        vec3 old_color = imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).xyz;
        imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(mix(old_color, contribAccum, a), 1.f));
    }
}