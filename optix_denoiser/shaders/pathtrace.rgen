// clang-format off
layout(location = 0) rayPayloadEXT HitPayload payload;
layout(location = 1) rayPayloadEXT GbufferPayload payloadGbuf;

layout(set = 0, binding = eTlas) uniform accelerationStructureEXT topLevelAS;
// #OPTIX_D
layout(set = 0, binding = eOutImage) uniform mediump image2D image;
layout(set = 0, binding = eOutAlbedo) uniform mediump image2D gAlbedo;
layout(set = 0, binding = eOutNormal) uniform mediump image2D gNormal;
layout(set = 0, binding = eOutDepth) uniform highp image2D gDepth;
layout(set = 0, binding = eOutDisparity) uniform highp image2D gDisparity;
layout(set = 0, binding = eRayStats) buffer RayStats_
{
  uint raysRPrimary;
  uint raysLPrimary;
} rayStats;

layout(set = 1, binding = eFrameInfo) uniform FrameInfo_ { FrameInfo frameInfo; };
// clang-format on

layout(push_constant) uniform RtxPushConstant_
{
  PushConstant pc;
};


/*
    Choose warping mode:
    0 = Simple linear warping    bom
    1 = Fluid-like warping       meh
    2 = Adaptive scene-aware warping  muito bom
    3 = Perlin noise organic warping  melhor
    4 = Multi-frequency adaptive warping  mto bom.
    No geral varia pouco, mas tive uma melhor sensação no merge do perlin
*/
#define WARP_MODE_SIMPLE 0
#define WARP_MODE_FLUID 1
#define WARP_MODE_ADAPTIVE 2
#define WARP_MODE_PERLIN 3
#define WARP_MODE_MULTIFREQ 4

// Make this configurable via push constant
//int warpMode = WARP_MODE_MULTIFREQ; // Default to best mode
int warpMode = WARP_MODE_MULTIFREQ; // Default to simple for testing

// #OPTIX_D
mediump vec4 gUnpackedAlbedo = vec4(0);
mediump vec3 gUnpackedNormal = vec3(0);

bool doReprojection = false; // true if copy other view
bool isLeftView = false;
bool isDominantView = false;
bool isNotDominantView = false;
int leftEye = 0; // Left eye index
int rightEye = 1; // Right eye index
int dominantEye = rightEye; // associate dominant eye to the passId = 0 (passes first) 

// dominant and non-dominant eyes view matrices
mat4 dominantViewInv, dominantProjInv, nonDomViewInv, nonDomProjInv;
mat4 dominantView, dominantProj, nonDomView, nonDomProj;
int halfWidth = 0;
mediump float dist = 0.0; // distance from center of the screen
mediump float radius = 0.0;
highp float farDistLinear = 0.0; // Linear Far ;TODO: pass real far from CPU
highp float nearDistLinear = 0.0; // Linear Near
highp float farDistNorm = 1.0; // Normalized Far
highp float nearDistNorm = 0.0; // Normalized Near
highp float eyeSeparation = 0.065; // Average eye separation in meters
// Not related with bounce depth of rays
mediump float maxDepthThreshold = 0.9; // this is normalized
// if fov is 90 degrees, focal lenght = (0.5 * imageWidth) / tan(0.5 * fov) = (0.5 * 800) / tan(0.5 * 90) = 400 pixels
mediump float fovDegrees = 90.0; // Field of view in degrees
mediump float halfWidthPixels = 0.0;

// Precomputed values set once in main() to avoid recalculation per-pixel
mediump float gTanHalfFov = 1.0;
mediump float gFocalLengthPixels = 0.0;
mediump float gMaxComfortableParallaxPixels = 0.0;
bool doDebug = false;
// Reprojection depth-check parameters
int reprojCheckSize = 3;                 // M in your MxM neighborhood (odd recommended)
float reprojMaxDepthDiffMeters = 0.5;    // max allowed depth difference (meters)
int reprojRequireValidSamples = 4;       // minimal valid samples in neighborhood
float baseBorderThickness = 100.0;
float baseDegreeBorder = 2.0; // degrees
int quadrantTilt;
// The higher the threshold, more raytracing
float upperDepthThreshold = 0.5;    // Quad 1
float leftDepthThreshold =  1.0;    // Quad 2
float rightDepthThreshold =  1.0;   // Quad 0
float bottomDepthThreshold =  2.5;  // Quad 3
/*
    0 = Raytrace, 
    1 = normal reprojected mid range, 
    2 = normal reprojected max depth;
    3 = blended-reprojected
*/
int debugColor = 0;


vec2 uv;
vec2 ndc;

//-----------------------------------------------------------------------
// Shared view matrix selection — eliminates duplicated logic
//-----------------------------------------------------------------------
void getViewMatrices(out mat4 viewInv, out mat4 projInv)
{
  bool useDominant = (dominantEye == rightEye) ? !isLeftView : isLeftView;
  viewInv = useDominant ? dominantViewInv : nonDomViewInv;
  projInv = useDominant ? dominantProjInv : nonDomProjInv;
}

// depthValue is alrdy normalized linear depth [0,1] and  Multiply by far dist to world dist
float getWorldDepth(float normalizedDepth) {
    //return depthValue * farDistLinear;
    return nearDistLinear + normalizedDepth * (farDistLinear - nearDistLinear);
}

int getEyeQuadrant()
{
    vec2 p = vec2(gl_LaunchIDEXT.xy);
    float hw = float(halfWidth);
    float fw = float(gl_LaunchSizeEXT.x);
    float fh = float(gl_LaunchSizeEXT.y);

    // per-eye horizontal range
    float eyeX0 = isLeftView ? 0.0 : hw;
    float eyeX1 = isLeftView ? hw : fw;

    // eye center in global coords
    vec2 center = vec2((eyeX0 + eyeX1) * 0.5, fh * 0.5);
    vec2 d = p - center;

    // flip Y for screen coordinate convention
    float ang = degrees(atan(-d.y, d.x));
    if (ang < 0.0) ang += 360.0;

    // Map angles to quadrants:
    // right: -45..45  -> 1
    // top:   45..135  -> 2
    // left:  135..225 -> 3
    // bottom:225..315 -> 0
    if (ang < 45.0 || ang >= 315.0) return 0;
    if (ang < 135.0)                return 1;
    if (ang < 225.0)                return 2;
    return 3;
}


/* Parallax angle calculation
  theta = 2 * atan(DX / (2 * D)) where DX = parallax in pixels
  D = screen distance in pixels
*/
ivec2 clampToViewBounds(ivec2 coord, bool targetIsLeft, int halfWidth) {
    coord.y = clamp(coord.y, 0, int(gl_LaunchSizeEXT.y) - 1);
    if (targetIsLeft) {
        coord.x = clamp(coord.x, 0, halfWidth - 1);
    }
    else {
        coord.x = clamp(coord.x, halfWidth, int(gl_LaunchSizeEXT.x) - 1);
    }
    return coord;
}

// Reproject a world position from depth and screen position
vec3 reprojectWorldPosition(vec2 screenPos, float depth, mat4 viewInv, mat4 projInv)
{
    float worldDepth = getWorldDepth(depth);

    vec2 uv = (screenPos + 0.5) / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 clipSpace = vec4(ndc, 0.01, 1.0);
    vec4 viewSpace = projInv * clipSpace;
    if (abs(viewSpace.w) < 1e-6) {
        return vec3(0.0);
    }

    vec3 dirView = normalize(viewSpace.xyz / viewSpace.w);

    // Ray origin in world space (camera position)
    vec3 originWorld = (viewInv * vec4(0.0, 0.0, 0.0, 1.0)).xyz;

    // Transform view direction to world direction
    vec3 dirWorld = (viewInv * vec4(dirView, 0.0)).xyz;
    dirWorld = normalize(dirWorld);

    vec3 worldPos = originWorld + dirWorld * worldDepth;

    if (length(worldPos) > 10000.0) { // clamp to reasonable range
        return vec3(0.0);
    }
    return worldPos;
}

//-----------------------------------------------------------------------
// Sampling the pixel
//-----------------------------------------------------------------------
vec3 samplePixel(inout uint seed, vec2 adjustedPixelPos, bool captureDepth, out float outPrimaryT)
{
  outPrimaryT = -1.0;
  // Subpixel jitter: send the ray through a different position inside the pixel each time, to provide antialiasing.
  vec2 subpixel_jitter = (captureDepth || pc.frame == 0) ? vec2(0.5f, 0.5f) 
                      : vec2(rand(seed), rand(seed));

  const vec2 pixelCenter = adjustedPixelPos + subpixel_jitter;
  const vec2 inUV        = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
  const vec2 d           = inUV * 2.0 - 1.0;

  mat4 viewInv, projInv;
  getViewMatrices(viewInv, projInv);

  vec4 origin    = viewInv * vec4(0.0, 0.0, 0.0, 1.0);
  vec4 target    = projInv * vec4(d.x, d.y, 0.01, 1.0);
  vec4 direction = viewInv * vec4(normalize(target.xyz), 0.0);

  const uint  rayFlags  = gl_RayFlagsCullBackFacingTrianglesEXT;
  const float tMin      = 0.001;
  const float tMax      = INFINITE;

  payload.contrib      = vec3(0.0, 0.0, 0.0);
  payload.weight       = vec3(1.0, 1.0, 1.0);
  payload.seed         = seed;
  payload.hitT         = INFINITE;
  payload.rayOrigin    = origin.xyz;
  payload.rayDirection = direction.xyz;
  payload.bsdfPdf      = 0.0; // Primary camera ray: no competing NEE -> env MIS weight = 1

  vec3 weightAccum  = vec3(1.0, 1.0, 1.0);
  vec3 contribAccum = vec3(0.0, 0.0, 0.0);

  
  if (isLeftView)
    atomicAdd(rayStats.raysLPrimary, 1u);
  else
    atomicAdd(rayStats.raysRPrimary, 1u);


  // bounces
  for(int bounce = 0; bounce < pc.maxDepth; bounce++)
  {
    traceRayEXT(topLevelAS,            // acceleration structure
                rayFlags,              // rayFlags
                0xFF,                  // cullMask
                0,                     // sbtRecordOffset
                0,                     // sbtRecordStride
                0,                     // missIndex
                payload.rayOrigin,     // ray origin
                tMin,                  // ray min range
                payload.rayDirection,  // ray direction
                tMax,                  // ray max range
                0                      // payload (location = 0)
    );
    // Capture primary ray distance once (first bounce)
    if(captureDepth && bounce == 0 && outPrimaryT < 0.0)
      outPrimaryT = payload.hitT;


    // Accumulating results
    contribAccum += payload.contrib * weightAccum;
    weightAccum *= payload.weight;

    // Stopping recursion
    if(payload.hitT == INFINITE)
      break;

    // Russian-Roulette
    float rrPcont = min(max(weightAccum.x, max(weightAccum.y, weightAccum.z)) + 0.001, 0.95);
    if(rand(payload.seed) >= rrPcont)
      break;  // paths with low throughput that won't contribute
    weightAccum /= rrPcont;
  }

  // Removing fireflies
  float lum = dot(contribAccum, vec3(0.212671f, 0.715160f, 0.072169f));
  if(lum > frameInfo.maxLuminance)
  {
    contribAccum *= frameInfo.maxLuminance / lum;
  }

  seed = payload.seed;
  return contribAccum;
}

//-----------------------------------------------------------------------
// Trace a single ray in the middle of the pixel to retrieve the
// Albedo and normal. Also, forcing all objects to be opaque
//-----------------------------------------------------------------------
// #OPTIX_D
void traceAlbedo(vec2 adjustedPixelPos)
{
    /*if (pc.passId == 1 && !isDominantView) {
        // Just return without tracing - we'll use values from the dominant view
        gUnpackedAlbedo = vec4(0.5, 0.5, 0.5, 1.0); // Fallback gray
        gUnpackedNormal = vec3(0.0, 0.0, 1.0);      // Fallback normal
        return;
    }*/

     // For non-dominant view in reprojection zone, use stored values
  if (isNotDominantView && doReprojection && pc.passId == 1) {
    // Load from dominant view instead of tracing
    ivec2 otherCoord = ivec2(gl_LaunchIDEXT.xy);
    if (isLeftView) {
      otherCoord.x += halfWidth;
    } else {
      otherCoord.x -= halfWidth;
    }
    
    gUnpackedAlbedo = imageLoad(gAlbedo, otherCoord);
    vec4 normalPacked = imageLoad(gNormal, otherCoord);
    gUnpackedNormal = normalPacked.rgb * 2.0 - 1.0;
    return;
  }
  const vec2 pixelCenter = adjustedPixelPos + vec2(0.5f, 0.5f);
  const vec2 inUV        = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
  const vec2 d           = inUV * 2.0 - 1.0;

  mat4 viewInv, projInv; 
  getViewMatrices(viewInv, projInv);

  vec4 origin    = viewInv * vec4(0.0, 0.0, 0.0, 1.0);
  vec4 target    = projInv * vec4(d.x, d.y, 0.01, 1.0);
  vec4 direction = viewInv * vec4(normalize(target.xyz), 0.0);
  const uint  rayFlags  = gl_RayFlagsOpaqueEXT;
  const float tMin      = 0.001;
  const float tMax      = INFINITE;

  payloadGbuf.packAlbedo = 0;
  payloadGbuf.packNormal = 0;
  payloadGbuf.packDepth = 0;

  traceRayEXT(topLevelAS,     // acceleration structure
              rayFlags,       // rayFlags
              0xFF,           // cullMask
              1,              // sbtRecordOffset --- Using the Gbuffer.rchit
              0,              // sbtRecordStride
              1,              // missIndex --- Using the Gbuffer.rmiss
              origin.xyz,     // ray origin
              tMin,           // ray min range
              direction.xyz,  // ray direction
              tMax,           // ray max range
              1               // payload --- Using the GbufferPayload
  );

  gUnpackedAlbedo = unpackUnorm4x8(payloadGbuf.packAlbedo);
  gUnpackedNormal = decompress_unit_vec(payloadGbuf.packNormal);
}
/*
float calculateParallaxPixels(float normalizedDepth) {
    float worldDist = getWorldDepth(normalizedDepth);
    return (eyeSeparation * gFocalLengthPixels) / worldDist;
}
*/
// Calculate parallax in pixels based on depth general with fov
// First calculate raw parallax
// Calculate the angle
// Get maximum comfortable parallax for your setup
// For objects in front of screen (negative parallax), be more restrictive
// Reference says negative parallax should be closer to zero
// Clamp based on direction
    // Negative parallax (object in front of screen)
    // Positive parallax (object behind screen)
// Also ensure it doesn't exceed half the screen width
    
// For your 1612x1023 resolution:
// Half width = 806 pixels per eye
// 8° occlusion at 90° FOV = ~72 pixels occluded
// + 2° safety = ~18 pixels
// Total ~90 pixels occluded on each side
    
// Validated parallax calculation
float calculateParallaxPixelsValidated(float depth) {
    float worldDepth = getWorldDepth(depth);
    float rawParallax = (eyeSeparation * gFocalLengthPixels) / worldDepth;
    
    // For very close objects (under 2 meters), be extremely conservative
    if (worldDepth < 2.0) {
        // Exponential falloff for close objects - they're better raytraced
        float closenessFactor = pow(worldDepth / 2.0, 2.0); // 0 at depth 0, 1 at depth 2
        return rawParallax * closenessFactor;
    }
    
    // For close-medium objects (2-5m), linear falloff
    if (worldDepth < 5.0) {
        float t = (worldDepth - 2.0) / 3.0; // 0 to 1 over 2-5m range
        float falloff = mix(0.4, 1.0, t); // Start at 40% at 2m, full at 5m
        return rawParallax * falloff;
    }
    
    // For far objects (depth > 10m), use exact parallax without clamping
    if (worldDepth > 10.0) {
        return rawParallax;
    }
    
    // For 5-10m range, normal clamping
    float maxComfortable = gMaxComfortableParallaxPixels;
    float minComfortable = -maxComfortable * 0.3; // Less negative for objects in front
    
    return clamp(rawParallax, minComfortable, maxComfortable);
}


float warpStrength(float dist, float radius, float borderThickness) {
    if (dist < radius) return 0.0;
    if (dist > radius + borderThickness) return 0.0;

    return clamp((dist - radius) / borderThickness, 0.0, 1.0);
}

// Fluid-like warping with multiple frequency components
float fluidWarpStrength(float dist, float radius, float borderThickness, vec2 pixelPos, float time) {
    if (dist < radius) return 0.0;
    if (dist > radius + borderThickness) return 0.0;
    
    // Normalized distance in transition zone (0 to 1)
    float t = (dist - radius) / borderThickness;
    
    // Smoothstep for basic transition
    float base = smoothstep(0.0, 1.0, t);
    
    // Add sinusoidal variation based on pixel position (like fluid waves)
    vec2 normalizedPos = pixelPos / vec2(gl_LaunchSizeEXT.xy);
    float angleVariation = sin(normalizedPos.x * 10.0 + normalizedPos.y * 7.0 + time * 0.5) * 0.15;
    float radialVariation = sin(dist * 0.02 + time * 0.3) * 0.1;
    
    // Combine variations - stronger near edges
    float variation = (angleVariation + radialVariation) * (1.0 - base * 0.7);
    
    // Final warping strength with controlled variation
    return clamp(base + variation, 0.0, 1.0);
}

// Warping that adapts to scene depth and geometry
float adaptiveWarpStrength(float dist, float radius, float borderThickness, 
                          float depth, vec2 pixelPos, vec3 normal, float time) {
    if (dist < radius) return 0.0;
    if (dist > radius + borderThickness) return 0.0;
    
    float t = (dist - radius) / borderThickness;
    
    // Base warping strength
    float base = smoothstep(0.0, 1.0, t);
    
    // Depth influence: objects farther away warp more gradually
    float depthFactor = clamp((depth - nearDistNorm) / (farDistNorm - nearDistNorm), 0.0, 1.0);
    float depthMod = mix(0.7, 1.3, depthFactor); // Range: 0.7 to 1.3
    
    // Normal influence: warp less on surfaces facing viewer
    float facingFactor = abs(dot(normal, vec3(0.0, 0.0, 1.0))); // Assuming camera looks down -Z
    float normalMod = mix(1.2, 0.8, facingFactor); // More warp on edges, less on faces
    
    // Add fluid-like perturbation
    vec2 uv = pixelPos / vec2(gl_LaunchSizeEXT.xy);
    float noise = sin(uv.x * 15.0 + time * 0.4) * 
                  sin(uv.y * 12.0 + time * 0.3) * 
                  cos((uv.x + uv.y) * 8.0 + time * 0.5) * 0.1;
    
    // Combine all factors
    float strength = base * depthMod * normalMod + noise;
    
    return clamp(strength, 0.0, 1.0);
}

// Simple 2D noise for organic warping
float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    
    vec2 u = f * f * (3.0 - 2.0 * f);
    
    return mix(mix(hash(i + vec2(0.0, 0.0)),
                   hash(i + vec2(1.0, 0.0)), u.x),
               mix(hash(i + vec2(0.0, 1.0)),
                   hash(i + vec2(1.0, 1.0)), u.x), u.y);
}

float perlinWarpStrength(float dist, float radius, float borderThickness, 
                        vec2 pixelPos, float time, float depth) {
    if (dist < radius) return 0.0;
    if (dist > radius + borderThickness) return 0.0;
    
    float t = (dist - radius) / borderThickness;
    
    // Base transition
    float base = smoothstep(0.0, 1.0, t);
    
    // Generate organic noise pattern
    vec2 noiseCoord = pixelPos * 0.01 + vec2(time * 0.1, 0.0);
    float organicNoise = noise(noiseCoord) * 0.2;
    
    // Depth-aware noise intensity (less noise on close objects)
    float depthFactor = clamp(depth * 2.0, 0.0, 1.0);
    float noiseIntensity = mix(0.3, 0.1, depthFactor);
    
    // Apply noise with fading near center
    float noiseMod = organicNoise * noiseIntensity * (1.0 - smoothstep(0.0, 0.5, base));
    
    return clamp(base + noiseMod, 0.0, 1.0);
}

// === BEST WARPING SOLUTION ===
float adaptiveMultiFrequencyWarp(float dist, float radius, float borderThickness,
                                float depth, vec2 pixelPos, vec3 normal, float time) {
    if (dist < radius) return 0.0;
    if (dist > radius + borderThickness) return 0.0;
    
    // Base transition (smoothstep for smooth edges)
    float t = (dist - radius) / borderThickness;
    float base = smoothstep(0.0, 1.0, t);
    
    // Depth adaptation: farther objects transition more smoothly
    float depthFactor = clamp((depth - nearDistNorm) / (farDistNorm - nearDistNorm), 0.0, 1.0);
    float depthInfluence = mix(0.3, 1.0, depthFactor); // 0.3-1.0 range
    
    // Normal adaptation: less warping on surfaces facing camera
    float facing = abs(dot(normalize(normal), vec3(0.0, 0.0, 1.0)));
    float normalInfluence = mix(1.2, 0.8, facing); // More warp on edges
    
    // Multi-frequency noise for "wobbly fluid" effect
    vec2 uv = pixelPos / vec2(gl_LaunchSizeEXT.xy) * 3.0;
    float timeScaled = time * 0.2;
    // Low frequency - broad waves
    float lowFreq = sin(uv.x * 2.0 + timeScaled) * 
                    sin(uv.y * 1.5 + timeScaled * 0.7) * 0.1;
    // Medium frequency - medium detail
    float medFreq = sin(uv.x * 8.0 + timeScaled * 1.3) * 
                    cos(uv.y * 6.0 + timeScaled * 0.9) * 0.05;
    // High frequency - fine detail (fades near center)
    float highFreq = sin(uv.x * 25.0 + timeScaled * 2.1) * 
                     sin(uv.y * 18.0 + timeScaled * 1.5) * 0.02;
    // Combine frequencies with different weights
    float noise = (lowFreq + medFreq + highFreq) * (1.0 - base * 0.8);
    // Final adaptive warping strength
    float strength = base * depthInfluence * normalInfluence + noise;
    return clamp(strength, 0.0, 1.0);
}

